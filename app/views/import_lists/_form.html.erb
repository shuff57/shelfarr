<%= form_with model: import_list, class: "space-y-5" do |f| %>
  <% if import_list.errors.any? %>
    <div class="bg-red-500/10 border border-red-500/20 rounded-lg p-4 text-red-400 text-sm">
      <ul class="list-disc list-inside">
        <% import_list.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium text-gray-300 mb-1" %>
    <%= f.text_field :name, required: true, placeholder: "e.g. My Goodreads want-to-read",
          class: "w-full rounded-md border border-gray-700 bg-gray-800 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 px-3 py-2" %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :list_type, "List type", class: "block text-sm font-medium text-gray-300 mb-1" %>
      <%= f.select :list_type, ImportList::LIST_TYPES.map { |value, label| [ label, value ] }, {},
            class: "w-full rounded-md border border-gray-700 bg-gray-800 text-white focus:outline-none focus:ring-2 focus:ring-blue-500 px-3 py-2" %>
    </div>
    <div>
      <%= f.label :book_type, "Format", class: "block text-sm font-medium text-gray-300 mb-1" %>
      <%= f.select :book_type, ImportList.book_types.keys.map { |t| [ t.titleize, t ] }, {},
            class: "w-full rounded-md border border-gray-700 bg-gray-800 text-white focus:outline-none focus:ring-2 focus:ring-blue-500 px-3 py-2" %>
    </div>
  </div>

  <div>
    <%= f.label :source_id, "Search query or Open Library subject", class: "block text-sm font-medium text-gray-300 mb-1" %>
    <%= f.text_field :source_id, placeholder: "e.g. fantasy  (for Saved search / Open Library subject)",
          class: "w-full rounded-md border border-gray-700 bg-gray-800 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 px-3 py-2" %>
    <p class="text-xs text-gray-500 mt-1">Used for "Saved search" and "Open Library subject" list types.</p>
  </div>

  <div>
    <%= f.label :source_url, "RSS feed URL", class: "block text-sm font-medium text-gray-300 mb-1" %>
    <%= f.text_field :source_url, placeholder: "https://www.goodreads.com/review/list_rss/...",
          class: "w-full rounded-md border border-gray-700 bg-gray-800 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 px-3 py-2" %>
    <p class="text-xs text-gray-500 mt-1">Used for the "Goodreads RSS feed" list type.</p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :item_limit, "Max items per sync", class: "block text-sm font-medium text-gray-300 mb-1" %>
      <%= f.number_field :item_limit, min: 1, max: 200,
            class: "w-full rounded-md border border-gray-700 bg-gray-800 text-white focus:outline-none focus:ring-2 focus:ring-blue-500 px-3 py-2" %>
    </div>
    <div class="flex items-end gap-6 pb-2">
      <label class="inline-flex items-center gap-2 text-sm text-gray-300">
        <%= f.check_box :auto_request %>
        Auto-request matches
      </label>
      <label class="inline-flex items-center gap-2 text-sm text-gray-300">
        <%= f.check_box :enabled %>
        Enabled
      </label>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit import_list.persisted? ? "Save list" : "Create list", class: "rounded-md px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium cursor-pointer" %>
    <%= link_to "Cancel", import_lists_path, class: "text-gray-400 hover:text-white text-sm" %>
  </div>
<% end %>
