<% content_for :title, "Import Lists" %>

<div class="mb-6 flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
  <div>
    <h1 class="text-2xl font-bold text-white">Import Lists</h1>
    <p class="text-sm text-gray-500 mt-1">Sync external book lists and auto-request their titles.</p>
  </div>
  <div class="flex items-center gap-2 self-start">
    <%= link_to "Followed Authors", author_follows_path, class: "rounded-md px-4 py-2 bg-gray-800 hover:bg-gray-700 text-white text-sm font-medium transition" %>
    <%= link_to "New List", new_import_list_path, class: "rounded-md px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium transition" %>
  </div>
</div>

<% if @import_lists.empty? %>
  <div class="text-center py-12 text-gray-500">
    No import lists yet. <%= link_to "Create one", new_import_list_path, class: "text-blue-400 hover:text-blue-300 underline" %> to pull in a Goodreads shelf, an Open Library subject, or a saved search.
  </div>
<% else %>
  <div class="overflow-hidden rounded-xl ring-1 ring-gray-800">
    <table class="min-w-full divide-y divide-gray-800">
      <thead class="bg-gray-900">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wide">Name</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wide">Type</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wide">Last sync</th>
          <th class="px-4 py-3 text-right text-xs font-semibold text-gray-400 uppercase tracking-wide">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-800 bg-gray-950">
        <% @import_lists.each do |list| %>
          <tr>
            <td class="px-4 py-3 text-sm text-white font-medium">
              <%= list.name %>
              <span class="ml-2 text-xs text-gray-500"><%= list.book_type.titleize %></span>
              <% unless list.enabled? %>
                <span class="ml-2 text-xs rounded-full bg-gray-700 px-2 py-0.5 text-gray-300">disabled</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-sm text-gray-400"><%= list.list_type_label %></td>
            <td class="px-4 py-3 text-sm text-gray-500">
              <% if list.last_synced_at %>
                <%= time_ago_in_words(list.last_synced_at) %> ago
                <% if list.last_sync_status.present? %>
                  <span class="block text-xs text-gray-600"><%= list.last_sync_status %></span>
                <% end %>
              <% else %>
                pending
              <% end %>
            </td>
            <td class="px-4 py-3 text-right">
              <div class="inline-flex items-center gap-2">
                <%= button_to "Sync now", sync_import_list_path(list), method: :post,
                      class: "rounded-md px-3 py-1.5 bg-gray-800 hover:bg-gray-700 text-gray-200 text-xs cursor-pointer" %>
                <%= link_to "Edit", edit_import_list_path(list), class: "rounded-md px-3 py-1.5 bg-gray-800 hover:bg-gray-700 text-gray-200 text-xs" %>
                <%= button_to "Delete", import_list_path(list), method: :delete,
                      form: { data: { turbo_confirm: "Delete #{list.name}?" } },
                      class: "rounded-md px-3 py-1.5 bg-red-600/80 hover:bg-red-500 text-white text-xs cursor-pointer" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
