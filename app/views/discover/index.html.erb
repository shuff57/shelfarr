<% content_for :title, "Discover" %>

<div class="mb-6">
  <h1 class="text-2xl font-bold text-white">Discover</h1>
  <p class="text-sm text-gray-500 mt-1">More from authors you follow and authors already in your library.</p>
</div>

<% unless @metadata_available %>
  <div class="bg-amber-500/10 border border-amber-500/20 rounded-lg p-4 text-amber-300 mb-6">
    Configure a metadata provider (Hardcover, Google Books or Open Library) in
    <%= link_to "Admin → Settings", admin_settings_path, class: "underline hover:text-amber-100" %> to get recommendations.
  </div>
<% end %>

<% if @recommendations.blank? %>
  <div class="text-center py-16">
    <svg class="mx-auto h-16 w-16 mb-4 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
    </svg>
    <p class="text-lg font-medium text-gray-400">Nothing to discover yet</p>
    <p class="text-sm mt-1 text-gray-500">
      <%= link_to "Follow some authors", author_follows_path, class: "text-blue-400 hover:text-blue-300 underline" %>
      or request a few books, and recommendations will show up here.
    </p>
  </div>
<% else %>
  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
    <% @recommendations.each do |result| %>
      <%= render "search/result_card", result: result, existing_books_lookup: @existing_books_lookup %>
    <% end %>
  </div>
<% end %>
