<% content_for :title, @book.title %>
<div class="flex h-screen flex-col text-gray-200"
     data-controller="reader"
     data-reader-format-value="<%= @book.reader_format %>"
     data-reader-file-url-value="<%= file_library_path(@book) %>"
     data-reader-progress-url-value="<%= progress_library_path(@book) %>">

  <header class="flex items-center justify-between gap-3 border-b border-gray-800 bg-gray-900 px-3 py-2">
    <%= link_to library_path(@book), class: "shrink-0 text-blue-400 hover:text-blue-300 text-sm" do %>
      &larr; Back
    <% end %>
    <div class="min-w-0 flex-1 text-center">
      <p class="truncate text-sm font-medium"><%= @book.title %></p>
      <% if @book.author.present? %>
        <p class="truncate text-xs text-gray-500"><%= @book.author %></p>
      <% end %>
    </div>
    <div class="flex shrink-0 items-center gap-2">
      <button type="button" data-reader-target="prev" data-action="reader#prev"
              class="rounded px-2 py-1 text-sm bg-gray-800 hover:bg-gray-700">‹</button>
      <span data-reader-target="percent" class="w-10 text-center text-xs text-gray-400">0%</span>
      <button type="button" data-reader-target="next" data-action="reader#next"
              class="rounded px-2 py-1 text-sm bg-gray-800 hover:bg-gray-700">›</button>
    </div>
  </header>

  <main data-reader-target="viewport" class="relative flex-1 overflow-auto bg-gray-950"></main>

  <p data-reader-target="status" class="hidden px-3 py-2 text-center text-sm text-gray-400"></p>
</div>
