<% content_for :title, @book.title %>
<div class="relative h-screen overflow-hidden bg-gray-950 text-gray-200"
     data-controller="reader"
     data-reader-format-value="<%= @book.reader_format %>"
     data-reader-file-url-value="<%= file_library_path(@book) %>"
     data-reader-progress-url-value="<%= progress_library_path(@book) %>"
     data-action="keyup@window->reader#onKey">

  <%# ---- Top chrome (auto-hides in immersive mode) ---- %>
  <header data-reader-target="chrome"
          class="absolute inset-x-0 top-0 z-30 flex items-center justify-between gap-3 border-b border-gray-800/70 bg-gray-900/95 px-3 py-2 backdrop-blur transition-transform duration-300">
    <%= link_to library_path(@book), class: "shrink-0 text-blue-400 hover:text-blue-300 text-sm" do %>
      &larr; Back
    <% end %>
    <div class="min-w-0 flex-1 text-center">
      <p class="truncate text-sm font-medium"><%= @book.title %></p>
      <% if @book.author.present? %>
        <p class="truncate text-xs text-gray-500"><%= @book.author %></p>
      <% end %>
    </div>
    <div class="flex shrink-0 items-center gap-1" data-reader-target="epubControls">
      <button type="button" data-action="reader#toggleToc" title="Contents"
              class="rounded px-2 py-1 text-sm hover:bg-gray-800">☰</button>
      <button type="button" data-action="reader#toggleSettings" title="Display settings"
              class="rounded px-2 py-1 text-sm font-semibold hover:bg-gray-800">Aa</button>
    </div>
  </header>

  <%# ---- Table of Contents drawer ---- %>
  <aside data-reader-target="toc"
         class="absolute inset-y-0 left-0 z-40 hidden w-80 max-w-[85vw] overflow-y-auto border-r border-gray-800 bg-gray-900 p-4 shadow-2xl">
    <div class="mb-3 flex items-center justify-between">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-400">Contents</h2>
      <button type="button" data-action="reader#toggleToc" class="rounded px-2 text-gray-400 hover:bg-gray-800">✕</button>
    </div>
    <nav data-reader-target="tocList" class="space-y-1 text-sm"></nav>
  </aside>

  <%# ---- Display settings panel ---- %>
  <div data-reader-target="settings"
       class="absolute right-3 top-14 z-40 hidden w-72 max-w-[90vw] space-y-4 rounded-lg border border-gray-800 bg-gray-900 p-4 shadow-2xl">
    <div>
      <p class="mb-1 text-xs uppercase tracking-wide text-gray-500">Font size</p>
      <div class="flex items-center gap-2">
        <button type="button" data-action="reader#fontSmaller" class="flex-1 rounded bg-gray-800 py-1.5 text-sm hover:bg-gray-700">A−</button>
        <span data-reader-target="fontSizeLabel" class="w-12 text-center text-sm text-gray-400">100%</span>
        <button type="button" data-action="reader#fontLarger" class="flex-1 rounded bg-gray-800 py-1.5 text-lg hover:bg-gray-700">A+</button>
      </div>
    </div>
    <div>
      <p class="mb-1 text-xs uppercase tracking-wide text-gray-500">Font</p>
      <div class="grid grid-cols-3 gap-1.5">
        <button type="button" data-action="reader#setFont" data-font="serif" class="reader-opt rounded bg-gray-800 py-1.5 text-sm hover:bg-gray-700" style="font-family: Georgia, serif">Serif</button>
        <button type="button" data-action="reader#setFont" data-font="sans" class="reader-opt rounded bg-gray-800 py-1.5 text-sm hover:bg-gray-700" style="font-family: system-ui, sans-serif">Sans</button>
        <button type="button" data-action="reader#setFont" data-font="dyslexic" class="reader-opt rounded bg-gray-800 py-1.5 text-xs hover:bg-gray-700">Dyslexic</button>
      </div>
    </div>
    <div>
      <p class="mb-1 text-xs uppercase tracking-wide text-gray-500">Line spacing</p>
      <input type="range" min="1.2" max="2.2" step="0.1" data-reader-target="lineHeight"
             data-action="input->reader#setLineHeight" class="w-full accent-blue-500">
    </div>
    <div>
      <p class="mb-1 text-xs uppercase tracking-wide text-gray-500">Margins</p>
      <input type="range" min="0" max="18" step="2" data-reader-target="margin"
             data-action="input->reader#setMargin" class="w-full accent-blue-500">
    </div>
    <div>
      <p class="mb-1 text-xs uppercase tracking-wide text-gray-500">Theme</p>
      <div class="grid grid-cols-3 gap-1.5">
        <button type="button" data-action="reader#setTheme" data-theme="light" class="reader-opt rounded border border-gray-700 bg-white py-1.5 text-sm text-gray-900">Light</button>
        <button type="button" data-action="reader#setTheme" data-theme="sepia" class="reader-opt rounded border border-gray-700 py-1.5 text-sm" style="background:#f4ecd8;color:#5b4636">Sepia</button>
        <button type="button" data-action="reader#setTheme" data-theme="dark" class="reader-opt rounded border border-gray-700 bg-gray-950 py-1.5 text-sm text-gray-100">Dark</button>
      </div>
    </div>
    <div>
      <p class="mb-1 text-xs uppercase tracking-wide text-gray-500">Layout</p>
      <div class="grid grid-cols-2 gap-1.5">
        <button type="button" data-action="reader#setFlow" data-flow="paginated" class="reader-opt rounded bg-gray-800 py-1.5 text-sm hover:bg-gray-700">Paged</button>
        <button type="button" data-action="reader#setFlow" data-flow="scrolled-doc" class="reader-opt rounded bg-gray-800 py-1.5 text-sm hover:bg-gray-700">Scrolled</button>
      </div>
    </div>
  </div>

  <%# ---- Backdrop that closes panels ---- %>
  <div data-reader-target="backdrop" data-action="reader#closePanels"
       class="absolute inset-0 z-20 hidden bg-black/40"></div>

  <%# ---- Reading viewport ---- %>
  <main data-reader-target="viewport" class="h-full w-full"></main>

  <%# ---- Edge tap-zones for paging (center stays interactive for scroll/select/toggle) ---- %>
  <button type="button" data-action="reader#prev" aria-label="Previous page"
          class="group absolute inset-y-0 left-0 z-10 flex w-[30%] items-center justify-start cursor-w-resize">
    <span class="ml-1 flex h-14 w-10 items-center justify-center rounded-r-xl bg-gray-900/30 text-3xl leading-none text-white/40 shadow backdrop-blur-sm transition group-hover:bg-gray-900/70 group-hover:text-white">&lsaquo;</span>
  </button>
  <button type="button" data-action="reader#next" aria-label="Next page"
          class="group absolute inset-y-0 right-0 z-10 flex w-[30%] items-center justify-end cursor-e-resize">
    <span class="mr-1 flex h-14 w-10 items-center justify-center rounded-l-xl bg-gray-900/30 text-3xl leading-none text-white/40 shadow backdrop-blur-sm transition group-hover:bg-gray-900/70 group-hover:text-white">&rsaquo;</span>
  </button>

  <%# ---- Bottom chrome: chapter + scrubber + percent ---- %>
  <footer data-reader-target="chromeBottom"
          class="absolute inset-x-0 bottom-0 z-30 flex items-center gap-3 border-t border-gray-800/70 bg-gray-900/95 px-4 py-2 backdrop-blur transition-transform duration-300">
    <span data-reader-target="chapter" class="hidden min-w-0 max-w-[28%] truncate text-xs text-gray-400 sm:block"></span>
    <input type="range" min="0" max="1000" value="0" data-reader-target="scrub"
           data-action="change->reader#scrub" class="flex-1 accent-blue-500">
    <span data-reader-target="percent" class="w-10 text-right text-xs text-gray-400">0%</span>
  </footer>

  <p data-reader-target="status" class="absolute inset-0 z-10 hidden place-content-center text-center text-sm text-gray-400"></p>
</div>
